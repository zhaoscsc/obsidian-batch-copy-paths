{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ES2018",
		"module": "ESNext",
		"moduleResolution": "node",
		"lib": ["DOM", "ES2018"],
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["main.ts"]
}
